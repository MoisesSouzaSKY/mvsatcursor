rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    // ===== MULTIEMPRESA (SaaS) =====
    // Fonte de verdade do tenant: usuarios/{uid}
    function userDocPath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function userDoc() {
      return get(userDocPath());
    }

    function hasUserDoc() {
      return isAuthenticated() && exists(userDocPath());
    }

    function userIsActive() {
      return hasUserDoc() && userDoc().data.ativo == true;
    }

    function userEmpresaId() {
      return hasUserDoc() ? userDoc().data.empresaId : null;
    }

    function userTipo() {
      return hasUserDoc() ? userDoc().data.tipo : null;
    }

    function isTenantMember(empresaId) {
      return userIsActive() && userEmpresaId() == empresaId;
    }

    function isTenantAdmin(empresaId) {
      return isTenantMember(empresaId) && userTipo() == 'admin';
    }

    function isTenantAdminOrGerente(empresaId) {
      return isTenantMember(empresaId) && (userTipo() == 'admin' || userTipo() == 'gerente');
    }

    function permissionDocPath(empresaId) {
      return /databases/$(database)/documents/empresas/$(empresaId)/employee_permissions/$(request.auth.uid);
    }

    function hasPermission(empresaId, module, action) {
      return isTenantAdmin(empresaId)
        || (isTenantMember(empresaId)
          && exists(permissionDocPath(empresaId))
          && get(permissionDocPath(empresaId)).data.permissions[module][action] == true);
    }

    // ===== LEGADO (claims antigas) - compatibilidade temporária =====
    function isAdminLegacy() {
      return isAuthenticated() &&
             (request.auth.token.role == 'admin' ||
              request.auth.token.role == 'Admin' ||
              request.auth.token.admin == true);
    }

    function isGerenteLegacy() {
      return isAuthenticated() &&
             (request.auth.token.role == 'gerente' ||
              request.auth.token.role == 'Gerente' ||
              request.auth.token.gerente == true);
    }

    function isAdminOrGerenteLegacy() {
      return isAdminLegacy() || isGerenteLegacy();
    }

    function isFinanceiroLegacy() {
      return isAuthenticated() &&
             (request.auth.token.role == 'financeiro' ||
              request.auth.token.role == 'Financeiro' ||
              request.auth.token.financeiro == true);
    }

    function isAtendimentoLegacy() {
      return isAuthenticated() &&
             (request.auth.token.role == 'atendimento' ||
              request.auth.token.role == 'Atendimento' ||
              request.auth.token.atendimento == true);
    }

    // ===== usuarios/{uid} =====
    match /usuarios/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      // Auto-cadastro seguro:
      // - cada novo usuário cria a própria empresa com ID igual ao próprio UID
      // - impede que alguém "entre" em outra empresa chutando empresaId
      allow create: if isAuthenticated()
        && request.auth.uid == uid
        && request.resource.data.empresaId == uid
        && request.resource.data.tipo == 'admin'
        && request.resource.data.ativo == true
        ;

      // Permitir o usuário atualizar apenas dados pessoais (não pode trocar empresa/tipo/email/ativo)
      allow update: if isAuthenticated()
        && request.auth.uid == uid
        && request.resource.data.empresaId == resource.data.empresaId
        && request.resource.data.tipo == resource.data.tipo
        && request.resource.data.email == resource.data.email
        && request.resource.data.ativo == resource.data.ativo;

      allow delete: if false;
    }

    // ===== empresas/{empresaId} + subcoleções =====
    match /empresas/{empresaId} {
      allow read: if isTenantMember(empresaId);
      // Auto-cadastro: permitir criar a própria empresa antes do documento usuarios/{uid} existir
      allow create: if isAuthenticated()
        && request.auth.uid == empresaId
        && !exists(/databases/$(database)/documents/empresas/$(empresaId));

      allow update, delete: if isTenantAdmin(empresaId);

      match /clientes/{docId} {
        allow read: if hasPermission(empresaId, 'clientes', 'view');
        allow create: if hasPermission(empresaId, 'clientes', 'create');
        allow update: if hasPermission(empresaId, 'clientes', 'edit');
        allow delete: if hasPermission(empresaId, 'clientes', 'delete');
      }

      match /assinaturas/{docId} {
        allow read: if hasPermission(empresaId, 'sky', 'assinaturas.view');
        allow create: if hasPermission(empresaId, 'sky', 'assinaturas.create');
        allow update: if hasPermission(empresaId, 'sky', 'assinaturas.edit');
        allow delete: if hasPermission(empresaId, 'sky', 'assinaturas.delete');
      }

      match /equipamentos/{docId} {
        allow read: if hasPermission(empresaId, 'sky', 'equipamentos.view');
        allow create: if hasPermission(empresaId, 'sky', 'equipamentos.create');
        allow update: if hasPermission(empresaId, 'sky', 'equipamentos.edit');
        allow delete: if hasPermission(empresaId, 'sky', 'equipamentos.delete');

        // Histórico de trocas de equipamento
        match /trocas/{swapId} {
          allow read: if isTenantMember(empresaId);
          allow create: if isTenantAdminOrGerente(empresaId);
          allow update, delete: if false;
        }

        // Histórico de exclusões/restaurações do equipamento
        match /exclusoes/{exclusionId} {
          allow read: if isTenantMember(empresaId);
          allow create: if isTenantAdminOrGerente(empresaId);
          allow update, delete: if false;
        }
      }

      // Registro centralizado para listagem de equipamentos inativos
      match /equipamentos_excluidos/{equipamentoId} {
        allow read: if isTenantMember(empresaId);
        allow create, update: if isTenantAdminOrGerente(empresaId);
        allow delete: if false;
      }

      match /tvbox/{docId} {
        allow read: if hasPermission(empresaId, 'tvbox', 'view');
        allow create: if hasPermission(empresaId, 'tvbox', 'create');
        allow update: if hasPermission(empresaId, 'tvbox', 'edit');
        allow delete: if hasPermission(empresaId, 'tvbox', 'delete');
      }

      match /tvbox_assinaturas/{docId} {
        allow read: if hasPermission(empresaId, 'tvbox', 'view');
        allow create: if hasPermission(empresaId, 'tvbox', 'create');
        allow update: if hasPermission(empresaId, 'tvbox', 'edit') || hasPermission(empresaId, 'tvbox', 'renew');
        allow delete: if hasPermission(empresaId, 'tvbox', 'delete');

        // Histórico importado do LEGADO (somente leitura no client)
        match /historico_legado/{legacyDocId} {
          allow read: if isTenantMember(empresaId);
          allow write: if false;
        }
      }

      match /lost_devices/{docId} {
        allow read: if isTenantMember(empresaId);
        allow create, update, delete: if isTenantAdminOrGerente(empresaId);
      }

      match /cobrancas/{docId} {
        allow read: if hasPermission(empresaId, 'cobrancas', 'view');
        allow create: if hasPermission(empresaId, 'cobrancas', 'create');
        allow update: if hasPermission(empresaId, 'cobrancas', 'edit') || hasPermission(empresaId, 'cobrancas', 'registerPayment');
        allow delete: if hasPermission(empresaId, 'cobrancas', 'delete');
      }

      match /cobrancas_arquivadas/{docId} {
        allow read: if hasPermission(empresaId, 'cobrancas', 'view');
        allow create: if hasPermission(empresaId, 'cobrancas', 'create');
        allow update: if hasPermission(empresaId, 'cobrancas', 'edit') || hasPermission(empresaId, 'cobrancas', 'registerPayment');
        allow delete: if hasPermission(empresaId, 'cobrancas', 'delete');
      }

      match /despesas/{docId} {
        // A renovação de TV Box precisa consultar a despesa determinística
        // antes de criá-la, para manter a operação idempotente. O perfil
        // TV BOX não deve ganhar acesso geral ao módulo financeiro.
        allow get: if hasPermission(empresaId, 'despesas', 'view')
          || hasPermission(empresaId, 'tvbox', 'renew');
        allow list: if hasPermission(empresaId, 'despesas', 'view');
        allow create: if hasPermission(empresaId, 'despesas', 'create')
          || hasPermission(empresaId, 'tvbox', 'renew');
        allow update: if hasPermission(empresaId, 'despesas', 'edit');
        allow delete: if hasPermission(empresaId, 'despesas', 'delete');
      }

      match /faturas_sky/{docId} {
        allow read: if hasPermission(empresaId, 'sky', 'faturas.view');
        function validFaturaSky(data) {
          return data.keys().hasAll([
              'assinaturaId', 'codigoAssinatura', 'nomeAssinatura',
              'competencia', 'vencimento', 'verificarEm',
              'possivelCorteEm', 'valor', 'valorPago'
            ])
            && data.keys().hasOnly([
              'assinaturaId', 'codigoAssinatura', 'nomeAssinatura',
              'competencia', 'vencimento', 'verificarEm',
              'possivelCorteEm', 'valor', 'valorPago', 'status',
              'dataValorInformado', 'valorInformadoPor', 'dataPagamento',
              'formaPagamento', 'pagamentoRegistradoPor', 'comprovante',
              'numeroReferencia', 'observacoes', 'despesaId',
              'createdAt', 'updatedAt'
            ])
            && data.assinaturaId is string
            && data.codigoAssinatura is string
            && data.nomeAssinatura is string
            && data.competencia is string
            && data.vencimento is timestamp
            && data.verificarEm is timestamp
            && data.possivelCorteEm is timestamp
            && (data.valor == null || data.valor is number)
            && (data.valorPago == null || data.valorPago is number);
        }

        allow create: if (hasPermission(empresaId, 'sky', 'faturas.edit') || hasPermission(empresaId, 'sky', 'faturas.regularize'))
          && validFaturaSky(request.resource.data);
        allow update: if (hasPermission(empresaId, 'sky', 'faturas.edit') || hasPermission(empresaId, 'sky', 'faturas.regularize'))
          && validFaturaSky(request.resource.data)
          && request.resource.data.assinaturaId == resource.data.assinaturaId
          && request.resource.data.competencia == resource.data.competencia
          && request.resource.data.codigoAssinatura == resource.data.codigoAssinatura;
        allow delete: if hasPermission(empresaId, 'sky', 'faturas.edit');
      }

      match /funcionarios/{docId} {
        allow read: if isTenantAdmin(empresaId) || (isTenantMember(empresaId) && request.auth.uid == docId);
        allow create, update, delete: if isTenantAdmin(empresaId);
      }

      match /roles/{roleId} {
        allow read: if isTenantMember(empresaId);
        allow create, update, delete: if isTenantAdmin(empresaId);

        match /permissions/{permId} {
          allow read: if isTenantMember(empresaId);
          allow create, update, delete: if isTenantAdmin(empresaId);
        }
      }

      match /employee_permissions/{docId} {
        allow read: if isTenantAdmin(empresaId) || (isTenantMember(empresaId) && request.auth.uid == docId);
        allow create, update, delete: if isTenantAdmin(empresaId);
      }

      match /audit_logs/{docId} {
        allow read: if isTenantAdmin(empresaId)
          || hasPermission(empresaId, 'admin', 'history.view')
          || hasPermission(empresaId, 'cobrancas', 'view');
        allow create: if isTenantMember(empresaId)
          && (
            isTenantAdmin(empresaId)
            || request.resource.data.actorUserId == request.auth.uid
            || request.resource.data.usuarioId == request.auth.uid
            || (request.resource.data.keys().hasAny(['performedBy'])
              && request.resource.data.performedBy.uid == request.auth.uid)
          );
        allow update, delete: if false;
      }

      match /logs/{docId} {
        allow read: if isTenantAdminOrGerente(empresaId);
        allow create: if isTenantMember(empresaId);
        allow update, delete: if false;
      }

      match /config/{docId} {
        allow read: if isTenantMember(empresaId);
        allow create, update, delete: if isTenantAdminOrGerente(empresaId);
      }
    }

    // ===== LEGADO (coleções globais) =====
    // Importante: para evitar QUALQUER mistura entre empresas, o app SaaS usa APENAS
    // empresas/{empresaId}/... e estas coleções globais ficam bloqueadas no client.
    // (Admin SDK/scripts continuam funcionando pois bypassam rules.)

    // Regras para coleção de clientes (LEGADO - bloqueado)
    match /clientes/{clienteId} {
      allow read, write: if false;
    }

    // Regras para coleção de TV Box (LEGADO - bloqueado)
    match /tvbox/{tvboxId} {
      allow read, write: if false;
    }

    // Regras para coleção de assinaturas (LEGADO - bloqueado)
    match /assinaturas/{assinaturaId} {
      allow read, write: if false;
    }

    // Regras para coleção de TV Box Assinaturas (LEGADO - bloqueado)
    match /tvbox_assinaturas/{docId} {
      allow read, write: if false;
    }

    // Regras para coleção de cobranças arquivadas (LEGADO - bloqueado)
    match /cobrancas_arquivadas/{docId} {
      allow read, write: if false;
    }

    // Regras para coleção de funcionários (LEGADO - bloqueado)
    match /employees/{employeeId} {
      allow read, write: if false;
    }

    // Regras para permissões de funcionários (LEGADO - bloqueado)
    match /employee_permissions/{permissionId} {
      allow read, write: if false;
    }

    // Regras para coleção de cobranças (LEGADO - bloqueado)
    match /cobrancas/{cobrancaId} {
      allow read, write: if false;
    }

    // Regras para coleção de despesas (LEGADO - bloqueado)
    match /despesas/{despesaId} {
      allow read, write: if false;
    }

    // Regras para coleção de equipamentos (LEGADO - bloqueado)
    match /equipamentos/{equipamentoId} {
      allow read, write: if false;
    }

    // Regras para perfis/permissões (LEGADO - bloqueado)
    match /roles/{roleId} {
      allow read, write: if false;

      match /permissions/{permId} {
        allow read, write: if false;
      }
    }

    // Regras para auditoria (LEGADO - bloqueado)
    match /audit_logs/{logId} {
      allow read, write: if false;
    }

    // Regras para config (LEGADO - bloqueado)
    match /config/{configId} {
      allow read, write: if false;
    }

    // Fallback: negar por padrão (evita vazamento entre empresas)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
